{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc", "react"],
  "jsPlugins": [
    {
      "name": "s0-lint",
      "specifier": "./packages/s0-lint/src/index.ts"
    },
    {
      "name": "effect",
      "specifier": "@mpsuesser/oxlint-plugin-effect"
    },
    {
      "name": "anti-slop",
      "specifier": "anti-slop"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./node_modules/anti-slop/src/effect/index.ts"
    }
  ],
  "ignorePatterns": [
    "**/.cursor/plans/**",
    "node_modules",
    "dist",
    "**/.alchemy/**",
    "**/.output/**",
    "cloudflare-env-gen.d.ts",
    "**/*.gen.ts",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**"
  ],
  "rules": {
    "s0-lint/max-file-lines": "error",
    "s0-lint/no-colocated-tests": "error",
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    // Ad hoc typeof, unknown parameters, unknown returns, and open dictionaries are the
    // parsers for provider JSON, tool arguments, workflow manifests, and Durable Object
    // migration RPCs. Replacing them needs a schema migration. A closed schema would reject
    // live payloads, so these four rules stay off until that migration.
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "off",
    "anti-slop/no-unknown-returns": "off",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "off",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop-effect/no-manual-effect-error-tag": "error",
    "anti-slop-effect/no-manual-tag-comparison": "error",
    "anti-slop-effect/no-manual-tagged-construction": "error",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "anti-slop-effect/prefer-effect-match": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/api/index.ts",
        "apps/api/infra/**",
        "packages/api/src/server/**",
        "packages/infra/src/**",
        "packages/shared/src/**"
      ],
      "rules": {
        "s0-lint/no-if-statement": "error",
        "s0-lint/no-ternary": "error",
        "s0-lint/no-pipe-ladder": "error",
        "s0-lint/no-flatmap-ladder": "error",
        "s0-lint/no-effect-ladder": "error",
        "s0-lint/no-effect-call-in-effect-arg": "error",
        "s0-lint/no-nested-effect-call": "error",
        "s0-lint/no-effect-as": "error",
        "s0-lint/no-call-tower": "error",
        "s0-lint/no-option-as": "error",
        "s0-lint/no-arrow-ladder": "error",
        "s0-lint/no-branch-in-object": "error",
        "s0-lint/no-iife-wrapper": "error",
        "s0-lint/no-return-in-arrow": "error",
        "s0-lint/no-effect-never": "error",
        "s0-lint/no-effect-async": "error",
        "s0-lint/no-effect-do": "error",
        "s0-lint/no-effect-bind": "error",
        "s0-lint/no-nested-effect-gen": "error",
        "s0-lint/no-match-void-branch": "error",
        "s0-lint/no-match-effect-branch": "error",
        "s0-lint/warn-effect-sync-wrapper": "error",
        "s0-lint/no-effect-side-effect-wrapper": "error",
        "s0-lint/no-effect-orElse-ladder": "error",
        "s0-lint/no-return-in-callback": "error",
        "s0-lint/no-manual-effect-channels": "error",
        "s0-lint/prevent-dynamic-imports": "error",
        "s0-lint/prefer-option-over-null": "error",
        "s0-lint/avoid-untagged-errors": "error",
        "s0-lint/use-effect-otel": "error",
        "effect/avoid-try-catch": "warn",
        "effect/prefer-match-over-switch": "warn",
        "effect/imperative-loops": "warn",
        "effect/avoid-data-tagged-error": "warn",
        "effect/avoid-direct-json": "warn",
        "effect/avoid-option-getorthrow": "warn",
        "effect/avoid-process-env": "warn",
        "effect/effect-run-in-body": "warn",
        "effect/effect-promise-vs-trypromise": "warn",
        "effect/prefer-schema-class": "warn",
        "effect/avoid-any": "warn",
        "effect/avoid-non-null-assertion": "warn",
        "effect/avoid-native-fetch": "warn",
        "effect/prefer-effect-fn": "warn",
        "effect/prefer-namespace-imports": "warn",
        "effect/prefer-redacted-config": "warn",
        "effect/no-barrel-imports": "warn"
      }
    },
    {
      "files": [
        "apps/web/src/components/admin-ai-provider-panel.tsx",
        "apps/web/src/components/home-session-tools-dialog.tsx",
        "apps/web/src/components/workflows/page.tsx",
        "packages/api/src/server/background/ai-providers/litellm.ts",
        "packages/api/src/server/background/db/admin.ts",
        "packages/api/src/server/background/db/workflows.ts",
        "packages/api/src/server/background/workflows/slack-apps.ts",
        "packages/api/src/server/background/session/durable-object/processing.ts",
        "packages/api/src/server/effect/handlers/shared/control-plane/sessions.ts",
        "scripts/e2e/lifecycle.ts"
      ],
      "rules": {
        // These files are already at the 1000-line s0-lint cap. The spacing fix pushes them over it.
        "anti-slop/require-readable-spacing": "off"
      }
    },
    {
      "files": ["packages/infra/alchemy.run.ts", "packages/infra/src/index.ts"],
      "rules": {
        "effect/avoid-process-env": "off",
        "effect/avoid-node-imports": "off"
      }
    }
  ]
}
