{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc", "react"],
  "jsPlugins": [
    {
      "name": "s0-lint",
      "specifier": "./packages/s0-lint/src/index.ts"
    },
    {
      "name": "effect",
      "specifier": "@mpsuesser/oxlint-plugin-effect"
    },
    {
      "name": "anti-slop",
      "specifier": "anti-slop"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./node_modules/anti-slop/src/effect/index.ts"
    }
  ],
  "ignorePatterns": [
    "**/.cursor/plans/**",
    "node_modules",
    "dist",
    "**/.alchemy/**",
    "**/.output/**",
    "cloudflare-env-gen.d.ts",
    "**/*.gen.ts",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**"
  ],
  "rules": {
    "s0-lint/max-file-lines": "error",
    "s0-lint/no-colocated-tests": "error",
    "anti-slop/no-chained-type-assertions": "warn",
    "anti-slop/no-conditional-empty-object-spread": "warn",
    "anti-slop/no-known-value-widening": "warn",
    "anti-slop/no-module-mocking": "warn",
    "anti-slop/no-object-parameters": "warn",
    "anti-slop/no-reflect-apply": "warn",
    "anti-slop/no-reflect-get": "warn",
    "anti-slop/no-runtime-typeof": "warn",
    "anti-slop/no-shape-in-symbol-names": "warn",
    "anti-slop/no-unknown-parameters": "warn",
    "anti-slop/no-unknown-returns": "warn",
    "anti-slop/no-unknown-type-aliases": "warn",
    "anti-slop/no-unsafe-dictionary-type": "warn",
    "anti-slop/no-widen-then-assert": "warn",
    "anti-slop/require-safety-comment-for-type-assertion": "warn",
    "anti-slop-effect/no-service-constructor-imports": "warn"
  },
  "overrides": [
    {
      "files": [
        "apps/api/index.ts",
        "apps/api/infra/**",
        "packages/api/src/server/**",
        "packages/infra/src/**",
        "packages/shared/src/**"
      ],
      "rules": {
        "s0-lint/no-if-statement": "error",
        "s0-lint/no-ternary": "error",
        "s0-lint/no-pipe-ladder": "error",
        "s0-lint/no-flatmap-ladder": "error",
        "s0-lint/no-effect-ladder": "error",
        "s0-lint/no-effect-call-in-effect-arg": "error",
        "s0-lint/no-nested-effect-call": "error",
        "s0-lint/no-effect-as": "error",
        "s0-lint/no-call-tower": "error",
        "s0-lint/no-option-as": "error",
        "s0-lint/no-arrow-ladder": "error",
        "s0-lint/no-branch-in-object": "error",
        "s0-lint/no-iife-wrapper": "error",
        "s0-lint/no-return-in-arrow": "error",
        "s0-lint/no-effect-never": "error",
        "s0-lint/no-effect-async": "error",
        "s0-lint/no-effect-do": "error",
        "s0-lint/no-effect-bind": "error",
        "s0-lint/no-nested-effect-gen": "error",
        "s0-lint/no-match-void-branch": "error",
        "s0-lint/no-match-effect-branch": "error",
        "s0-lint/warn-effect-sync-wrapper": "error",
        "s0-lint/no-effect-side-effect-wrapper": "error",
        "s0-lint/no-effect-orElse-ladder": "error",
        "s0-lint/no-return-in-callback": "error",
        "s0-lint/no-manual-effect-channels": "error",
        "s0-lint/prevent-dynamic-imports": "error",
        "s0-lint/prefer-option-over-null": "error",
        "s0-lint/avoid-untagged-errors": "error",
        "s0-lint/use-effect-otel": "error",
        "effect/avoid-try-catch": "warn",
        "effect/prefer-match-over-switch": "warn",
        "effect/imperative-loops": "warn",
        "effect/avoid-data-tagged-error": "warn",
        "effect/avoid-direct-json": "warn",
        "effect/avoid-option-getorthrow": "warn",
        "effect/avoid-process-env": "warn",
        "effect/effect-run-in-body": "warn",
        "effect/effect-promise-vs-trypromise": "warn",
        "effect/prefer-schema-class": "warn",
        "effect/avoid-any": "warn",
        "effect/avoid-non-null-assertion": "warn",
        "effect/avoid-native-fetch": "warn",
        "effect/prefer-effect-fn": "warn",
        "effect/prefer-namespace-imports": "warn",
        "effect/prefer-redacted-config": "warn",
        "effect/no-barrel-imports": "warn"
      }
    },
    {
      "files": ["packages/infra/alchemy.run.ts", "packages/infra/src/index.ts"],
      "rules": {
        "effect/avoid-process-env": "off",
        "effect/avoid-node-imports": "off"
      }
    }
  ]
}
