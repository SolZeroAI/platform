{
  "name": "@solzero/creative",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "render:release": "tsx src/cli.ts render-release",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "react": "19.2.6",
    "takumi-js": "2.7.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/react": "19.2.14",
    "tsx": "^4.22.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.6"
  }
}
