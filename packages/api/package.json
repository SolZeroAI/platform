{
  "name": "@solzero/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "import": "./src/schemas.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./schema.pg": {
      "types": "./src/server/effect/db/schema.pg.ts",
      "import": "./src/server/effect/db/schema.pg.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.97",
    "@ai-sdk/openai": "4.0.109",
    "@ai-sdk/openai-compatible": "3.0.85",
    "@cfworker/json-schema": "4.1.6",
    "@cloudflare/codemode": "0.5.6",
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/dynamic-workflows": "0.1.1",
    "@cloudflare/shell": "0.5.0",
    "@cloudflare/think": "0.23.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@solzero/shared": "workspace:*",
    "agents": "0.33.0",
    "ai": "7.0.163",
    "better-auth": "1.7.18",
    "chat": "4.44.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.1.2",
    "jose": "6.2.16",
    "just-bash": "3.6.0",
    "postgres": "3.4.9",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "typescript": "7.0.2"
  }
}
