{
  "name": "@solzero/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "import": "./src/schemas.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "test": "nub exec --cwd ../.. vitest run --config packages/api/vitest.facets.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.18",
    "@ai-sdk/openai": "4.0.19",
    "@ai-sdk/openai-compatible": "3.0.14",
    "@cloudflare/codemode": "0.5.0",
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/dynamic-workflows": "0.1.1",
    "@cloudflare/shell": "0.4.3",
    "@cloudflare/think": "0.15.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/web-api": "^7.15.2",
    "@solzero/shared": "workspace:*",
    "agents": "0.19.0",
    "ai": "7.0.36",
    "better-auth": "^1.6.11",
    "cloudflare": "^5.2.0",
    "drizzle-orm": "1.0.0-rc.2-e38a2ba",
    "effect": "4.0.0-beta.100",
    "jose": "^6.2.1",
    "workers-ai-provider": "4.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.7",
    "@types/node": "^24.12.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
