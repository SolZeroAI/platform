{
  "name": "@solzero/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "import": "./src/schemas.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./schema.pg": {
      "types": "./src/server/effect/db/schema.pg.ts",
      "import": "./src/server/effect/db/schema.pg.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "NODE_OPTIONS='--import tsx' oxlint src",
    "lint:fix": "NODE_OPTIONS='--import tsx' oxlint --fix src",
    "test": "nub exec --cwd ../.. vitest run --config packages/api/vitest.facets.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.46",
    "@ai-sdk/openai": "4.0.52",
    "@ai-sdk/openai-compatible": "3.0.41",
    "@cloudflare/codemode": "0.5.0",
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/dynamic-workflows": "0.1.1",
    "@cloudflare/shell": "0.4.3",
    "@cloudflare/think": "0.15.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@slack/web-api": "^7.19.0",
    "@solzero/shared": "workspace:*",
    "agents": "0.19.0",
    "ai": "7.0.36",
    "better-auth": "1.6.24",
    "cloudflare": "^5.2.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-beta.107",
    "jose": "^6.2.10",
    "postgres": "^3.4.8",
    "workers-ai-provider": "4.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.7",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
