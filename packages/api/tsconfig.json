{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/server/*"],
      "infra/*": ["../infra/src/*"],
      "@solzero/shared": ["../shared/src/index.ts"],
      "@solzero/shared/*": ["../shared/src/*"],
      "@solzero/api": ["./src/index.ts"],
      "@solzero/api/*": ["./src/*"]
    },
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
