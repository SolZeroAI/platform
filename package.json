{
  "name": "s0-agent",
  "version": "0.0.0",
  "private": true,
  "description": "SolZero platform: a custom Agent, an agentic Workflow builder, always-on bots, and Codex, Grok, and Claude Code harnesses. One Cloudflare package.",
  "homepage": "https://github.com/SolZeroAI/platform#readme",
  "bugs": {
    "url": "https://github.com/SolZeroAI/platform/issues"
  },
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolZeroAI/platform.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "nub run dev:app",
    "dev:api": "nub run --filter @solzero/background-api dev",
    "dev:web": "nub run --filter @solzero/background-web dev",
    "dev:app": "nub run --cwd packages/infra dev",
    "dev:apps": "nub run dev:app",
    "dev:logs": "./scripts/watch-logs.sh",
    "build": "turbo run build",
    "effect:diagnostics": "effect-tsrs diagnostics --project tsconfig.json --lspconfig '{}'",
    "typecheck": "turbo run typecheck && nub run typecheck:e2e && nub run typecheck:migration",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "alchemy:state:bootstrap": "nub run --cwd packages/infra alchemy cloudflare bootstrap",
    "alchemy:state:tree": "CI=true nub run --cwd packages/infra alchemy state tree alchemy.state.run.ts",
    "alchemy:state:stacks": "CI=true nub run --cwd packages/infra alchemy state stacks alchemy.state.run.ts",
    "alchemy:state:stages": "CI=true nub run --cwd packages/infra alchemy state stages alchemy.state.run.ts",
    "alchemy:state:resources": "CI=true nub run --cwd packages/infra alchemy state resources alchemy.state.run.ts",
    "alchemy:state:get": "CI=true nub run --cwd packages/infra alchemy state get alchemy.state.run.ts",
    "auth:admin-password": "tsx scripts/print-admin-password.ts",
    "config:check": "tsx scripts/s0-config.ts check",
    "config:schema": "tsx scripts/s0-config.ts schema",
    "config:stage-url": "tsx scripts/s0-config.ts stage-url",
    "config:write-stage-vars": "tsx scripts/s0-config.ts write-stage-vars",
    "db:generate:pg": "drizzle-kit generate --config packages/infra/drizzle.config.ts",
    "db:pglite": "tsx scripts/pglite-dev-server.ts",
    "db:copy-d1-to-planetscale": "tsx scripts/copy-d1-to-planetscale.ts",
    "migration:types": "tsx scripts/migration/generate-types.ts",
    "migration:storage": "tsx scripts/migration/storage.ts",
    "typecheck:migration": "tsrs --noEmit -p tsconfig.migration.json",
    "creative:release-card": "nub run --filter @solzero/background-web render:release",
    "github:sync-env-secrets": "tsx scripts/sync-github-env-secrets.ts",
    "tegami": "tsx scripts/tegami.mts",
    "workflow:runtime:audit": "tsx scripts/workflows/audit-runtime-abi.ts",
    "clean": "turbo run clean",
    "infra:plan:dev": "nub run --cwd packages/infra plan:dev",
    "infra:plan:pre": "nub run --cwd packages/infra plan:pre",
    "infra:plan:prod": "nub run --cwd packages/infra plan:prod",
    "infra:deploy:dev": "nub run --cwd packages/infra deploy:dev",
    "infra:deploy:pre": "nub run --cwd packages/infra deploy:pre",
    "infra:deploy:prod": "nub run --cwd packages/infra deploy:prod",
    "infra:destroy:dev": "nub run --cwd packages/infra destroy:dev",
    "infra:destroy:pre": "nub run --cwd packages/infra destroy:pre",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint:fix:max": "oxlint --fix --fix-suggestions --fix-dangerously",
    "test": "nub run test:e2e",
    "test:config": "E2E_TELEMETRY_DISABLED=1 e2e run --config e2e.config-check.config.ts",
    "test:e2e": "tsx scripts/e2e/run.ts --exclude-tag external",
    "test:e2e:live": "tsx scripts/e2e/run.ts --no-cache --exclude-tag external",
    "test:e2e:cache-strict": "tsx scripts/e2e/run.ts --strict-cache --exclude-tag external",
    "test:e2e:cleanup": "tsx scripts/e2e/cleanup.ts",
    "test:e2e:install": "e2e-web install chromium --with-deps",
    "typecheck:e2e": "tsrs --noEmit -p tsconfig.e2e.json",
    "test:e2e:list": "e2e list",
    "test:e2e:all": "tsx scripts/e2e/run.ts",
    "test:e2e:external": "tsx scripts/e2e/run.ts --tag external",
    "test:e2e:lifecycle": "e2e run --config e2e.cleanup.config.ts",
    "test:e2e:mcp": "tsx scripts/e2e/run.ts --mcp"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.3",
    "alchemy": "2.0.0-beta.81",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "3.0.44",
    "@ai-sdk/provider-utils": "5.0.67",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@e2e-dev/decision": "0.3.0",
    "@e2e-dev/github": "0.4.3",
    "@e2e-dev/web": "0.15.3",
    "@electric-sql/pglite": "0.4.5",
    "@electric-sql/pglite-socket": "0.1.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mpsuesser/oxlint-plugin-effect": "0.2.2",
    "@types/node": "^24.13.3",
    "@types/semver": "7.8.0",
    "@yielded/effect-tsrs": "0.2.2",
    "ai": "7.0.152",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "e2e": "0.21.3",
    "esbuild": "0.28.2",
    "jsonc-parser": "^3.3.1",
    "miniflare": "5.20261006.1-alpha",
    "oxfmt": "^0.49.0",
    "oxlint": "1.89.0",
    "oxlint-plugin-solzero": "^0.1.0",
    "postgres": "3.4.9",
    "semver": "7.8.5",
    "tegami": "1.5.0",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "tsx": "^4.23.13",
    "turbo": "2.11.7",
    "typescript": "^7.0.2",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "@cloudflare/codemode": "0.5.1",
    "@effect/platform-node": "4.0.3",
    "@effect/platform-node-shared": "4.0.3",
    "@effect/sql-d1": "4.0.3",
    "@effect/sql-pg": "4.0.3",
    "@effect/sql-sqlite-do": "4.0.3",
    "@effect/vitest": "4.0.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ai": "7.0.152",
    "chat": "4.40.0",
    "effect": "4.0.3",
    "workerd": "1.20261006.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "0.9.6",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "24.15.0"
    }
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "nub@0.9.6",
  "allowScripts": {
    "@mongodb-js/zstd": true,
    "core-js-pure": true,
    "esbuild": true,
    "msgpackr-extract": true,
    "node-liblzma": true,
    "sharp": true,
    "unicode-animations": true,
    "workerd": true
  },
  "patchedDependencies": {
    "@cloudflare/containers@0.3.7": "patches/@cloudflare__containers@0.3.7.patch",
    "alchemy@2.0.0-beta.81": "patches/alchemy@2.0.0-beta.81.patch",
    "@ai-sdk/harness-codex@1.0.43": "patches/@ai-sdk+harness-codex@1.0.43.patch",
    "e2e@0.21.3": "patches/e2e@0.21.3.patch",
    "@e2e-dev/web@0.15.3": "patches/@e2e-dev+web@0.15.3.patch"
  }
}
