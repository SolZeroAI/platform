{
  "$schema": "https://alchemy.new/schema/v1/project.json",
  "schemaVersion": 1,
  "id": "solzero",
  "name": "SolZero",
  "description": "A secure, self-hosted AI agent platform built with Alchemy, Effect, and Cloudflare.",
  "publisher": {
    "name": "SolZero",
    "github": "SolZeroAI",
    "website": "https://solzero.dev",
  },
  "source": {
    "kind": "github-release",
    "repository": "SolZeroAI/platform",
  },
  "deployment": {
    "entrypoint": "packages/infra/alchemy.run.ts",
    "packageManager": "nub",
    "providers": ["cloudflare"],
    "defaultProvider": "cloudflare",
    "defaultStage": "prod",
  },
  "parameters": [
    {
      "name": "DATABASE",
      "label": "Database",
      "description": "Implementation path for the database. Cloudflare D1 is the default. PlanetScale Postgres is optional.",
      "required": true,
      "secret": false,
      "type": "select",
      "default": "d1",
      "paths": [
        {
          "id": "d1",
          "label": "Cloudflare D1",
          "description": "Default. Uses Cloudflare D1. No extra secrets.",
        },
        {
          "id": "planetscale",
          "label": "PlanetScale Postgres",
          "description": "Optional Postgres path. Requires PlanetScale service tokens.",
        },
      ],
    },
    {
      "name": "PLANETSCALE_SERVICE_TOKEN_ID",
      "label": "PlanetScale service token ID",
      "description": "Required only when Database is PlanetScale Postgres.",
      "required": true,
      "secret": true,
      "type": "string",
      "when": {
        "parameter": "DATABASE",
        "equals": "planetscale",
      },
    },
    {
      "name": "PLANETSCALE_SERVICE_TOKEN",
      "label": "PlanetScale service token",
      "description": "Required only when Database is PlanetScale Postgres.",
      "required": true,
      "secret": true,
      "type": "string",
      "when": {
        "parameter": "DATABASE",
        "equals": "planetscale",
      },
    },
    {
      "name": "PLANETSCALE_ORGANIZATION",
      "label": "PlanetScale organization",
      "description": "Required only when Database is PlanetScale Postgres.",
      "required": true,
      "secret": true,
      "type": "string",
      "when": {
        "parameter": "DATABASE",
        "equals": "planetscale",
      },
    },
    {
      "name": "S0_CONFIG_PROFILE",
      "label": "Configuration profile",
      "description": "Optional profile suffix for config files in the SolZero repository.",
      "required": false,
      "secret": false,
      "type": "string",
    },
    {
      "name": "S0_CONFIG_SECRETS_AUTH_ADMIN_PASSWORD",
      "label": "Administrator password",
      "description": "Signs in as admin@example.com. alchemy.new generates a 24-character password and shows it once. SolZero reads this value from the environment.",
      "required": true,
      "secret": true,
      "type": "string",
      "generate": "password",
    },
  ],
  "tags": ["agents", "cloudflare", "effect", "self-hosted"],
  "website": "https://solzero.dev",
}
