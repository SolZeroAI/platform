{
  "name": "@solzero/background-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nub run --cwd ../../packages/infra dev:web",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "deploy": "nub run deploy:prod",
    "deploy:dev": "nub run --cwd ../../packages/infra deploy:web:dev",
