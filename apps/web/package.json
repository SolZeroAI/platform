    "deploy:prod": "nub run --cwd ../../packages/infra deploy:web:prod",
    "typecheck": "tsc --noEmit",
    "lint": "NODE_OPTIONS='--import tsx' oxlint src scripts vite.config.ts",
    "lint:fix": "NODE_OPTIONS='--import tsx' oxlint --fix src scripts vite.config.ts",
    "render:release": "tsx scripts/render-release-card.ts render-release",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
