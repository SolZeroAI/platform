{
  "name": "@solzero/background-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "dev": "nub run --cwd ../../packages/infra dev:api",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "lint": "NODE_OPTIONS='--import tsx' oxlint index.ts src infra",
    "lint:fix": "NODE_OPTIONS='--import tsx' oxlint --fix index.ts src infra"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@solzero/api": "workspace:*",
    "@solzero/shared": "workspace:*"
  },
  "devDependencies": {
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.3",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "typescript": "^7.0.2"
  }
}
