{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "node"],
    "paths": {
      "infra/*": ["../../packages/infra/src/*"],
      "@solzero/api": ["../../packages/api/src/index.ts"],
      "@solzero/api/*": ["../../packages/api/src/*"],
      "@solzero/shared": ["../../packages/shared/src/index.ts"],
      "@solzero/shared/*": ["../../packages/shared/src/*"]
    },
    "noEmit": true
  },
  "include": ["index.ts", "env.d.ts", "src/**/*.ts", "src/**/*.tsx", "infra/**/*.ts"],
  "exclude": ["node_modules"]
}
