{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "$ref": "#/$defs/Union_" },
    "schemaVersion": { "type": "number", "enum": [1] },
    "deployment": {
      "type": "object",
      "properties": {
        "appName": { "type": "string" },
        "zone": { "type": "string" },
        "webFqdn": { "$ref": "#/$defs/Union_" },
        "apiFqdn": { "$ref": "#/$defs/Union_" },
        "useApiShield": { "type": "boolean" },
        "databaseEngine": {
          "anyOf": [{ "type": "string", "enum": ["d1", "planetscale"] }, { "type": "null" }]
        },
        "observability": {
          "type": "object",
          "properties": {
            "logsDestinations": { "type": "array", "items": { "type": "string" } },
            "tracesDestinations": { "type": "array", "items": { "type": "string" } },
            "logsHeadSamplingRate": {
              "anyOf": [
                { "type": "number", "allOf": [{ "minimum": 0, "maximum": 1 }] },
                { "$ref": "#/$defs/Union_1" }
              ]
            },
            "tracesHeadSamplingRate": {
              "anyOf": [
                { "type": "number", "allOf": [{ "minimum": 0, "maximum": 1 }] },
                { "$ref": "#/$defs/Union_1" }
              ]
            }
          },
          "required": [
            "logsDestinations",
            "tracesDestinations",
            "logsHeadSamplingRate",
            "tracesHeadSamplingRate"
          ],
          "additionalProperties": false
        }
      },
      "required": ["appName", "zone", "useApiShield", "observability"],
      "additionalProperties": false
    },
    "application": {
      "type": "object",
      "properties": {
        "logLevel": { "type": "string", "enum": ["trace", "debug"] },
        "sendSlackNotifications": { "type": "boolean" },
        "slackChannel": { "type": "string" },
        "sandboxInactivityTimeoutMs": { "$ref": "#/$defs/Union_2" },
        "showTestErrorButton": { "type": "boolean" },
        "betterAuthSessionTransferEnabled": { "type": "boolean" }
      },
      "required": [
        "logLevel",
        "sendSlackNotifications",
        "slackChannel",
        "sandboxInactivityTimeoutMs",
        "showTestErrorButton",
        "betterAuthSessionTransferEnabled"
      ],
      "additionalProperties": false
    },
    "admins": {
      "type": "object",
      "properties": {
        "adminEmails": { "type": "array", "items": { "type": "string" } },
        "adminDomains": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["adminEmails", "adminDomains"],
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "defaultSignInProviderId": { "type": "string" },
        "providers": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "enum": ["credential"] },
                  "enabled": { "type": "boolean" },
                  "displayName": { "type": "string" },
                  "capabilities": { "$ref": "#/$defs/Objects_" },
                  "provisioning": {
                    "type": "object",
                    "properties": { "scope": { "type": "string", "enum": ["configured-admins"] } },
                    "required": ["scope"],
                    "additionalProperties": false
                  }
                },
                "required": ["kind", "enabled", "displayName", "capabilities", "provisioning"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "enum": ["social"] },
                  "enabled": { "type": "boolean" },
                  "displayName": { "type": "string" },
                  "clientId": { "type": "string" },
                  "clientSecret": { "$ref": "#/$defs/Objects_1" },
                  "scopes": {
                    "anyOf": [
                      { "type": "array", "items": { "type": "string" } },
                      { "type": "null" }
                    ]
                  },
                  "capabilities": { "$ref": "#/$defs/Objects_" }
                },
                "required": [
                  "kind",
                  "enabled",
                  "displayName",
                  "clientId",
                  "clientSecret",
                  "capabilities"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "enum": ["oidc"] },
                  "enabled": { "type": "boolean" },
                  "displayName": { "type": "string" },
                  "issuer": { "type": "string" },
                  "clientId": { "type": "string" },
                  "clientSecret": { "$ref": "#/$defs/Objects_1" },
                  "scopes": {
                    "anyOf": [
                      { "type": "array", "items": { "type": "string" } },
                      { "type": "null" }
                    ]
                  },
                  "capabilities": { "$ref": "#/$defs/Objects_" }
                },
                "required": [
                  "kind",
                  "enabled",
                  "displayName",
                  "issuer",
                  "clientId",
                  "clientSecret",
                  "capabilities"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "adminPassword": { "$ref": "#/$defs/Union_3" }
      },
      "required": ["defaultSignInProviderId", "providers"],
      "additionalProperties": false
    },
    "aiProviders": {
      "type": "object",
      "properties": {
        "cloudflareAiGateway": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "cacheTtl": { "anyOf": [{ "$ref": "#/$defs/Union_2" }, { "type": "null" }] },
            "collectLogs": { "type": "boolean" },
            "defaultModel": { "type": "string" },
            "models": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "options": { "anyOf": [{ "type": "object" }, { "type": "null" }] },
                  "limit": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "context": { "$ref": "#/$defs/Union_2" },
                          "output": { "$ref": "#/$defs/Union_2" }
                        },
                        "required": ["context", "output"],
                        "additionalProperties": false
                      },
                      { "type": "null" }
                    ]
                  },
                  "reasoning": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "efforts": { "type": "array", "items": { "$ref": "#/$defs/Union_4" } },
                          "default": {
                            "anyOf": [{ "$ref": "#/$defs/Union_4" }, { "type": "null" }]
                          }
                        },
                        "required": ["efforts"],
                        "additionalProperties": false
                      },
                      { "type": "null" }
                    ]
                  },
                  "interleaved": {
                    "anyOf": [
                      {
                        "anyOf": [
                          { "type": "boolean", "enum": [true] },
                          {
                            "type": "object",
                            "properties": {
                              "field": {
                                "type": "string",
                                "enum": ["reasoning_content", "reasoning_details"]
                              }
                            },
                            "required": ["field"],
                            "additionalProperties": false
                          }
                        ]
                      },
                      { "type": "null" }
                    ]
                  },
                  "provider": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "npm": { "$ref": "#/$defs/Union_" },
                          "api": { "$ref": "#/$defs/Union_" }
                        },
                        "additionalProperties": false
                      },
                      { "type": "null" }
                    ]
                  }
                },
                "required": ["name"],
                "additionalProperties": false
              }
            },
            "providerKeys": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "openai": { "$ref": "#/$defs/Union_3" },
                    "anthropic": { "$ref": "#/$defs/Union_3" },
                    "xai": { "$ref": "#/$defs/Union_3" }
                  },
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            }
          },
          "required": ["enabled", "cacheTtl", "collectLogs", "defaultModel", "models"],
          "additionalProperties": false
        },
        "litellm": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "baseUrl": { "type": "string" },
                "defaultModel": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                "defaultReasoningLevel": {
                  "anyOf": [{ "$ref": "#/$defs/Union_4" }, { "type": "null" }]
                },
                "adapterOverrides": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "apiKey": { "$ref": "#/$defs/Union_3" }
              },
              "required": [
                "enabled",
                "baseUrl",
                "defaultModel",
                "defaultReasoningLevel",
                "adapterOverrides"
              ],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        }
      },
      "required": ["cloudflareAiGateway"],
      "additionalProperties": false
    },
    "mcpcf": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "baseUrl": { "type": "string" },
            "userOauthProviderId": { "type": "string" },
            "expectedIssuer": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "authTypeAllowlist": { "type": "array", "items": { "type": "string" } },
            "serverBlacklist": { "type": "array", "items": { "type": "string" } },
            "adminApiToken": { "$ref": "#/$defs/Union_3" }
          },
          "required": [
            "enabled",
            "baseUrl",
            "userOauthProviderId",
            "expectedIssuer",
            "authTypeAllowlist",
            "serverBlacklist"
          ],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "integrations": {
      "type": "object",
      "properties": {
        "githubApp": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "appId": { "type": "string" },
            "clientId": { "type": "string" },
            "slug": { "type": "string" },
            "clientSecret": { "$ref": "#/$defs/Objects_1" },
            "privateKey": { "$ref": "#/$defs/Objects_1" },
            "webhookSecret": { "$ref": "#/$defs/Union_3" }
          },
          "required": ["enabled", "appId", "clientId", "slug", "clientSecret", "privateKey"],
          "additionalProperties": false
        },
        "slack": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "botToken": { "$ref": "#/$defs/Objects_1" }
          },
          "required": ["enabled", "botToken"],
          "additionalProperties": false
        }
      },
      "required": ["githubApp", "slack"],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "betterAuthSecret": { "$ref": "#/$defs/Objects_1" },
        "mcpcfProxySigningSecret": { "$ref": "#/$defs/Objects_1" },
        "tokenEncryptionKey": { "$ref": "#/$defs/Objects_1" },
        "repositorySecretsEncryptionKey": { "$ref": "#/$defs/Objects_1" }
      },
      "required": [
        "betterAuthSecret",
        "mcpcfProxySigningSecret",
        "tokenEncryptionKey",
        "repositorySecretsEncryptionKey"
      ],
      "additionalProperties": false
    },
    "aiSearch": {
      "type": "object",
      "properties": {
        "serviceTokenId": {
          "anyOf": [
            { "anyOf": [{ "$ref": "#/$defs/Objects_1" }, { "type": "null" }] },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "deployment",
    "application",
    "admins",
    "auth",
    "aiProviders",
    "integrations",
    "security",
    "aiSearch"
  ],
  "additionalProperties": false,
  "$defs": {
    "Union_": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "Union_1": { "type": "string", "enum": ["Infinity", "-Infinity", "NaN"] },
    "Union_2": { "anyOf": [{ "type": "number" }, { "$ref": "#/$defs/Union_1" }] },
    "Objects_": {
      "type": "object",
      "properties": {
        "signIn": { "type": "boolean" },
        "provisionUsers": { "type": "boolean" },
        "link": { "type": "boolean" }
      },
      "required": ["signIn", "provisionUsers", "link"],
      "additionalProperties": false
    },
    "Objects_1": {
      "type": "object",
      "properties": {
        "env": { "type": "string" },
        "generateIfMissing": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] }
      },
      "required": ["env"],
      "additionalProperties": false
    },
    "Union_3": { "anyOf": [{ "$ref": "#/$defs/Objects_1" }, { "type": "null" }] },
    "Union_4": {
      "type": "string",
      "enum": ["none", "low", "medium", "high", "xhigh", "max", "minimal"]
    }
  }
}
