# Credentials used by IaC. Non-secret deployment and application settings live
# in config/<stage>.config.jsonc. Worker secrets live in the corresponding
# config/.dev.vars, config/.test.vars, config/.pre.vars, or config/.prod.vars file.

# https://developers.cloudflare.com/workers/wrangler/system-environment-variables/
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
WRANGLER_SEND_METRICS=false
