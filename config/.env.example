# Credentials used by IaC. Non-secret deployment and application settings live
# in config/<stage>.config.jsonc. Worker secrets live in the corresponding
# config/.dev.vars, config/.test.vars, config/.pre.vars, or config/.prod.vars file.

# https://developers.cloudflare.com/workers/wrangler/system-environment-variables/
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
WRANGLER_SEND_METRICS=false

# Required only when deployment.databaseEngine is "planetscale" and APP_DB_MODE=remote.
# PlanetScale has no free plan (~$5/mo). Leave these unset for the default D1 flavor.
# PLANETSCALE_ORGANIZATION=
# PLANETSCALE_API_TOKEN_ID=
# PLANETSCALE_API_TOKEN=

# PlanetScale flavor only. local = PGLite on 127.0.0.1:15432. remote = PlanetScale port 6432.
# APP_DB_MODE=local
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/postgres
