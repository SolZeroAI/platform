{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "oxlint.config.ts",
    "config/.env",
    "config/.dev.vars",
    "config/.test.vars",
    "config/.pre.vars",
    "config/.prod.vars",
    "config/*.config.jsonc",
    "config/s0.config.schema.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "@solzero/background-api#build": {
      "outputs": []
    },
    "@solzero/shared#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {},
    "clean": {
      "cache": false
    }
  }
}
