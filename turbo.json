{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".oxlintrc.json",
    "config/.env",
    "config/.dev.vars",
    "config/.test.vars",
    "config/.pre.vars",
    "config/.prod.vars",
    "config/*.config.jsonc",
    "config/c0.config.schema.json",
    "packages/c0-lint/src/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "@c0/background-api#build": {
      "outputs": []
    },
    "@c0/sandbox#build": {
      "outputs": []
    },
    "@c0-agent/shared#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
